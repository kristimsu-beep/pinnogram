/* =========================================================
   CAMERA
========================================================= */

let cameraYaw = 0;

let cameraPitch =
    THREE.MathUtils.degToRad(18);

let cameraDistance = 55;

let cameraInitialized = false;

let cockpitView = false;


/* =========================================================
   CAMERA UPDATE
========================================================= */

function updateCamera() {

    if (!airplane)
        return;


    if (cockpitView) {
    
        if (cockpitGroup)
            cockpitGroup.visible = true;
    
        const cockpitOffset =
            new THREE.Vector3(
                0,
                5.0,
                -9.2
            );
    
        cockpitOffset.applyQuaternion(
            airplane.quaternion
        );
    
        const cockpitPosition =
            airplane.position
                .clone()
                .add(cockpitOffset);
    
        camera.position.copy(
            cockpitPosition
        );
    
        const forward =
            new THREE.Vector3(
                0,
                2.8,
                -120
            );
    
        forward.applyQuaternion(
            airplane.quaternion
        );
    
        const lookTarget =
            airplane.position
                .clone()
                .add(forward);
    
        camera.lookAt(
            lookTarget
        );
    
        return;
    }

    if (cockpitGroup)
        cockpitGroup.visible = false;


    const offset =
        new THREE.Vector3();


    offset.x =
        Math.sin(cameraYaw) *
        Math.cos(cameraPitch) *
        cameraDistance;


    offset.y =
        Math.sin(cameraPitch) *
        cameraDistance;


    offset.z =
        Math.cos(cameraYaw) *
        Math.cos(cameraPitch) *
        cameraDistance;


    const desiredPosition =
        airplane.position
            .clone()
            .add(offset);


    if (!cameraInitialized) {

        camera.position.copy(
            desiredPosition
        );

        camera.lookAt(
            airplane.position
        );

        cameraInitialized = true;

    } else {

        camera.position.lerp(
            desiredPosition,
            .12
        );

        camera.lookAt(
            airplane.position
        );
    }
}


