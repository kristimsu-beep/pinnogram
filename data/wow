        ),
        new THREE.MeshStandardMaterial({
            color: 0x41464d,
            metalness: 0.7,
            roughness: 0.3
        })
    );

    towerTop.position.set(
        0,
        centralHeight + 40,
        0
    );

    towerTop.castShadow = true;
    city.add(towerTop);

    // Красный маяк
    const beaconLight = new THREE.PointLight(
        0xff3333,
