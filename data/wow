<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SkyWorld Flight Simulator</title>

<style>
* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
    font-family: Arial, sans-serif;
}

canvas {
    display: block;
}

#game {
    position: fixed;
    inset: 0;
    z-index: 1;
}

#ui {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    transform: translateZ(0);
}

.hud {
    position: absolute;
    top: 18px;
    left: 18px;
    padding: 14px 18px;
    min-width: 230px;
    color: white;
    background: rgba(5, 10, 18, 0.68);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 14px;
    backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}

.hud-title {
    font-size: 15px;
    font-weight: bold;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.hud-line {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    font-size: 13px;
    margin: 4px 0;
}

.hud-value {
    font-weight: bold;
    color: #9de8ff;
}

.time-box {
    position: absolute;
    top: 18px;
    right: 18px;
    padding: 12px 18px;
    color: white;
    background: rgba(5,10,18,0.68);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 14px;
    backdrop-filter: blur(8px);
    text-align: center;
}

.time-clock {
    font-size: 25px;
    font-weight: bold;
}

.time-period {
    margin-top: 3px;
    font-size: 12px;
    opacity: 0.8;
}

#navWrap {
    position: absolute;
    right: 18px;
    bottom: 18px;
    width: 270px;
    padding: 10px;
    background: rgba(5,10,18,0.72);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 16px;
    backdrop-filter: blur(8px);
}

#navTitle {
    color: white;
    font-size: 12px;
    margin: 0 0 7px 4px;
    letter-spacing: 1px;
}

#navMap {
    width: 250px;
    height: 250px;
    display: block;
    border-radius: 10px;
}

.controls {
    position: absolute;
    left: 18px;
    bottom: 18px;
    padding: 12px 15px;
    color: rgba(255,255,255,0.9);
    background: rgba(5,10,18,0.58);
    border: 1px solid rgba(255,255,255,0.13);
    border-radius: 13px;
    font-size: 12px;
    backdrop-filter: blur(7px);
}

.controls b {
    color: white;
}

.message {
    position: absolute;
    left: 50%;
    top: 82%;
    transform: translateX(-50%);
    color: white;
    padding: 11px 22px;
    background: rgba(0,0,0,0.62);
    border-radius: 30px;
    opacity: 0;
    transition: opacity .25s;
    font-size: 14px;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 24px;
    height: 24px;
    transform: translate(-50%, -50%);
    opacity: .55;
}

.crosshair::before,
.crosshair::after {
    content: "";
    position: absolute;
    background: white;
}

.crosshair::before {
    width: 24px;
    height: 1px;
    left: 0;
    top: 11px;
}

.crosshair::after {
    width: 1px;
    height: 24px;
    left: 11px;
    top: 0;
}

.camera-label {
    position: absolute;
    top: 75px;
    left: 50%;
    transform: translateX(-50%);
    color: white;
    padding: 6px 12px;
    background: rgba(0,0,0,0.4);
    border-radius: 20px;
    font-size: 11px;
    opacity: .75;
}

#menu {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: auto;
    background:
        radial-gradient(
            circle at center,
            rgba(35,100,150,.38),
            rgba(0,0,0,.93)
        );
}

.menu-box {
    width: min(620px, 90vw);
    padding: 42px;
    text-align: center;
    color: white;
    background: rgba(5,10,18,.78);
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 25px;
    backdrop-filter: blur(16px);
    box-shadow: 0 30px 100px rgba(0,0,0,.65);
}

.menu-title {
    font-size: 48px;
    font-weight: bold;
    letter-spacing: 3px;
    margin-bottom: 10px;
}

.menu-subtitle {
    opacity: .72;
    margin-bottom: 30px;
}

.start-btn {
    border: none;
    padding: 15px 42px;
    border-radius: 30px;
    background: linear-gradient(
        135deg,
        #39bfff,
        #1c6cff
    );
    color: white;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 8px 30px rgba(30,140,255,.35);
}

.start-btn:hover {
    transform: scale(1.04);
}

.menu-info {
    margin-top: 25px;
    color: rgba(255,255,255,.65);
    font-size: 12px;
    line-height: 1.8;
}

#cockpitHint {
    position: absolute;
    left: 50%;
    bottom: 25px;
    transform: translateX(-50%);
    color: rgba(255,255,255,.7);
    font-size: 11px;
}
</style>
</head>

<body>

<div id="game"></div>

<div id="ui">

    <div class="hud">

        <div class="hud-title">
            SKYWORLD FLIGHT
        </div>

        <div class="hud-line">
            <span>ALT</span>
            <span class="hud-value" id="altitude">0 m</span>
        </div>

        <div class="hud-line">
            <span>SPEED</span>
            <span class="hud-value" id="speed">0 km/h</span>
        </div>

        <div class="hud-line">
            <span>HDG</span>
            <span class="hud-value" id="heading">000°</span>
        </div>

        <div class="hud-line">
            <span>V/S</span>
            <span class="hud-value" id="verticalSpeed">0 m/s</span>
        </div>

        <div class="hud-line">
            <span>THROTTLE</span>
            <span class="hud-value" id="throttle">0%</span>
        </div>

        <div class="hud-line">
            <span>FUEL</span>
            <span class="hud-value" id="fuel">100%</span>
        </div>

        <div class="hud-line">
            <span>ENGINE</span>
            <span class="hud-value" id="engine">OFF</span>
        </div>

        <div class="hud-line">
            <span>BIOME</span>
            <span class="hud-value" id="biome">PLAINS</span>
        </div>

    </div>

    <div class="time-box">

        <div class="time-clock" id="timeClock">
            07:00
        </div>

        <div class="time-period" id="timePeriod">
            🌅 DAWN
        </div>

    </div>

    <div class="camera-label" id="cameraLabel">
        EXTERNAL VIEW
    </div>

    <div class="crosshair"></div>

    <div id="navWrap">

        <div id="navTitle">
            NAVIGATION / RELIEF
        </div>

        <canvas id="navMap"
                width="250"
                height="250">
        </canvas>

    </div>

    <div class="controls">

        <b>W / S</b> — pitch<br>
        <b>R / Y</b> — throttle<br>
        <b>A / D</b> — roll<br>
        <b>Q / E</b> — yaw<br>
        <b>SPACE</b> — engine<br>
        <b>1</b> — cockpit / external<br>
        <b>LMB</b> — camera<br>
        <b>WHEEL</b> — zoom

    </div>

    <div class="message" id="message"></div>

</div>


<div id="menu">

    <div class="menu-box">

        <div class="menu-title">
            SKYWORLD
        </div>

        <div class="menu-subtitle">
            FLIGHT SIMULATOR
        </div>

        <button class="start-btn" id="startButton">
            START FLIGHT
        </button>

        <div class="menu-info">
            Explore mountains, jungle, desert, Antarctica<br>
            and the giant MEGA CITY.<br><br>

            The complete game day lasts 5 real minutes.
        </div>

    </div>

</div>


<script type="module">

import * as THREE from
"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js";


/* =========================================================
   BASIC SETUP
========================================================= */

const container =
    document.getElementById("game");

const scene =
    new THREE.Scene();

scene.background =
    new THREE.Color(0x82cdf7);

scene.fog =
    new THREE.Fog(
        0x82cdf7,
        900,
        6500
    );


const camera =
    new THREE.PerspectiveCamera(
        65,
        innerWidth / innerHeight,
        0.1,
        30000
    );


const renderer =
    new THREE.WebGLRenderer({
        antialias: true
    });


/*
   LIGHT OPTIMIZATION:
   Было 2. Теперь максимум 1.5.
   Сам рендер и разрешение сцены не меняются.
*/
renderer.setPixelRatio(
    Math.min(devicePixelRatio, 1.5)
);

renderer.setSize(
    innerWidth,
    innerHeight
);

renderer.shadowMap.enabled = true;

renderer.shadowMap.type =
    THREE.PCFSoftShadowMap;

renderer.outputColorSpace =
    THREE.SRGBColorSpace;

container.appendChild(renderer.domElement);


/* =========================================================
   LIGHTING
========================================================= */

const hemiLight =
    new THREE.HemisphereLight(
        0xcceeff,
        0x35442b,
        1.6
    );

scene.add(hemiLight);


const sunLight =
    new THREE.DirectionalLight(
        0xffffff,
        2
    );

sunLight.castShadow = true;


/*
   LIGHT OPTIMIZATION:
   2048 -> 1024.
   Тени остаются включены.
*/
sunLight.shadow.mapSize.width = 1024;
sunLight.shadow.mapSize.height = 1024;

sunLight.shadow.camera.left = -2500;
sunLight.shadow.camera.right = 2500;
sunLight.shadow.camera.top = 2500;
sunLight.shadow.camera.bottom = -2500;

scene.add(sunLight);


const moonLight =
    new THREE.DirectionalLight(
        0x9ab7ff,
        0
    );

scene.add(moonLight);


/* =========================================================
   STARS
========================================================= */

const starGeometry =
    new THREE.BufferGeometry();

const starPositions = [];


/*
   LIGHT OPTIMIZATION:
   Было 1800.
   Стало 1000.
*/
for (let i = 0; i < 1000; i++) {

    const radius =
        7000 + Math.random() * 7000;

    const theta =
        Math.random() * Math.PI * 2;

    const phi =
        Math.acos(
            2 * Math.random() - 1
        );

    starPositions.push(
        radius *
        Math.sin(phi) *
        Math.cos(theta),

        radius *
        Math.cos(phi),

        radius *
        Math.sin(phi) *
        Math.sin(theta)
    );
}

starGeometry.setAttribute(
    "position",
    new THREE.Float32BufferAttribute(
        starPositions,
        3
    )
);

const starMaterial =
    new THREE.PointsMaterial({
        color: 0xffffff,
        size: 9,
        transparent: true,
        opacity: 0,
        depthWrite: false
    });

const stars =
    new THREE.Points(
        starGeometry,
        starMaterial
    );

scene.add(stars);


/* =========================================================
   MOON
========================================================= */

const moon =
    new THREE.Mesh(
        new THREE.SphereGeometry(
            130,
            32,
            32
        ),
        new THREE.MeshBasicMaterial({
            color: 0xe7ecff,
            transparent: true,
            opacity: 0
        })
    );

scene.add(moon);


/* =========================================================
   TERRAIN
========================================================= */

const terrainSize = 6500;


/*
   LIGHT OPTIMIZATION:
   Было 200x200.
   Стало 160x160.

   terrainHeight() НЕ МЕНЯЕМ.
*/
const terrainSegments = 160;


function terrainHeight(x, z) {

    let h = 0;

    h +=
        Math.sin(x * 0.0012) *
        35;

    h +=
        Math.cos(z * 0.0015) *
        30;

    h +=
        Math.sin((x + z) * 0.0021) *
        18;

    h +=
        Math.sin(
            x * 0.004 +
            z * 0.001
        ) * 10;


    const m1 =
        Math.exp(
            -Math.pow(
                (x + 900) / 700,
                2
            )
            -
            Math.pow(
                (z + 100) / 1200,
                2
            )
        );

    h += m1 * 390;


    const m2 =
        Math.exp(
            -Math.pow(
                (x - 1200) / 900,
                2
            )
            -
            Math.pow(
                (z - 900) / 700,
                2
            )
        );

    h += m2 * 300;


    h +=
        Math.sin(x * 0.006) *
        Math.cos(z * 0.005) *
        20;


    if (z > 1900) {

        const amount =
            Math.min(
                1,
                (z - 1900) / 1800
            );

        h += amount * 180;

        h +=
            Math.sin(x * 0.0028) *
            Math.cos(z * 0.0032) *
            100 *
            amount;

        h +=
            Math.sin((x - z) * 0.006) *
            45 *
            amount;
    }

    return h;
}
function islandTerrainHeight(x, z) {

    const h = terrainHeight(x, z);

    // Главный остров.
    // Он покрывает все основные города и аэропорты.
    const mainIsland =
        Math.exp(
            -Math.pow((x + 100) / 2700, 2)
            -Math.pow((z + 100) / 2100, 2)
        );

    // Западный остров
    const westIsland =
        Math.exp(
            -Math.pow((x + 2850) / 850, 2)
            -Math.pow((z - 800) / 1000, 2)
        );

    // Восточный остров
    const eastIsland =
        Math.exp(
            -Math.pow((x - 2850) / 850, 2)
            -Math.pow((z + 300) / 900, 2)
        );

    // Южный остров
    const southIsland =
        Math.exp(
            -Math.pow((x - 500) / 900, 2)
            -Math.pow((z - 2700) / 650, 2)
        );

    // Северный остров
    const northIsland =
        Math.exp(
            -Math.pow((x + 900) / 1000, 2)
            -Math.pow((z + 2850) / 650, 2)
        );

    const mask = Math.max(
        mainIsland,
        westIsland,
        eastIsland,
        southIsland,
        northIsland
    );

    // Мягкая береговая линия
    const land =
        THREE.MathUtils.smoothstep(
            mask,
            0.30,
            0.53
        );

    // Вода находится на -12
    return THREE.MathUtils.lerp(
        -12,
        h,
        land
    );
}

const terrainGeometry =
    new THREE.PlaneGeometry(
        terrainSize,
        terrainSize,
        terrainSegments,
        terrainSegments
    );

terrainGeometry.rotateX(
    -Math.PI / 2
);


const positionAttribute =
    terrainGeometry.attributes.position;


const colors = [];


for (
    let i = 0;
    i < positionAttribute.count;
    i++
) {

    const x =
        positionAttribute.getX(i);

    const z =
        positionAttribute.getZ(i);

    const h =
        islandTerrainHeight(x, z);

    let color;


    if (z > 1900) {

        const snow =
            THREE.MathUtils.clamp(
                0.75 + h / 700,
                0.75,
                1
            );

        color =
            new THREE.Color(
                snow,
                snow,
                snow
            );

    } else if (
        x > 600 &&
        z > 400
    ) {

        color =
            new THREE.Color(
                0xd2a85b
            );

    } else if (
        x < -500 &&
        z > 300
    ) {

        color =
            new THREE.Color(
                0x24763c
            );

    } else if (h > 260) {

        color =
            new THREE.Color(
                0x85847c
            );

    } else if (h > 140) {

        color =
            new THREE.Color(
                0x777844
            );

    } else {

        color =
            new THREE.Color(
                0x4d9347
            );
    }


    colors.push(
        color.r,
        color.g,
        color.b
    );
}


terrainGeometry.setAttribute(
    "color",
    new THREE.Float32BufferAttribute(
        colors,
        3
    )
);


const terrainMaterial =
    new THREE.MeshStandardMaterial({
        vertexColors: true,
        roughness: 0.92,
        metalness: 0.03
    });


const terrain =
    new THREE.Mesh(
        terrainGeometry,
        terrainMaterial
    );

terrain.receiveShadow = true;

scene.add(terrain);


/* =========================================================
   OCEAN
========================================================= */

const ocean =
    new THREE.Mesh(
        new THREE.PlaneGeometry(
            16000,
            16000
        ),
        new THREE.MeshStandardMaterial({
            color: 0x176b9b,
            roughness: .25,
            metalness: .05
        })
    );

ocean.rotation.x =
    -Math.PI / 2;

ocean.position.y = -12;

ocean.receiveShadow = true;

scene.add(ocean);


/* =========================================================
   ANTARCTIC ICE
========================================================= */

const antarctica =
    new THREE.Mesh(
        new THREE.PlaneGeometry(
            4500,
            1000
        ),
        new THREE.MeshStandardMaterial({
            color: 0xeaf5ff,
            roughness: .75
        })
    );

antarctica.rotation.x =
    -Math.PI / 2;

antarctica.position.set(
    0,
    4,
    2400
);

scene.add(antarctica);


/* =========================================================
   TREES
========================================================= */

function createTree(x, z) {
    const tree = new THREE.Group();

    // Ствол
    const trunkHeight = 18 + Math.random() * 12;

    const trunk = new THREE.Mesh(
        new THREE.CylinderGeometry(2.2, 3.2, trunkHeight, 8),
        new THREE.MeshStandardMaterial({
            color: 0x6b4226,
            roughness: 1
        })
    );

    trunk.position.y = trunkHeight / 2;
    trunk.castShadow = true;
    trunk.receiveShadow = true;
    tree.add(trunk);

    // Крона
    const crown = new THREE.Mesh(
        new THREE.SphereGeometry(13 + Math.random() * 5, 8, 6),
        new THREE.MeshStandardMaterial({
            color: 0x237a32,
            roughness: 1
        })
    );

    crown.position.y = trunkHeight + 8;
    crown.scale.y = 1.15;
    crown.castShadow = true;
    crown.receiveShadow = true;
    tree.add(crown);

    // Ставим дерево точно на новый островной рельеф
    tree.position.set(
        x,
        islandTerrainHeight(x, z),
        z
    );

    scene.add(tree);
    return tree;
}


/* =========================================================
   PALMS
========================================================= */

function createPalm(x, z) {
    const palm = new THREE.Group();

    // Ствол
    const trunkHeight = 22 + Math.random() * 10;

    const trunk = new THREE.Mesh(
        new THREE.CylinderGeometry(1.8, 2.8, trunkHeight, 8),
        new THREE.MeshStandardMaterial({
            color: 0x8a5a32,
            roughness: 1
        })
    );

    trunk.position.y = trunkHeight / 2;
    trunk.rotation.z = (Math.random() - 0.5) * 0.08;
    trunk.castShadow = true;
    trunk.receiveShadow = true;
    palm.add(trunk);

    // Крона пальмы
    const leafMaterial = new THREE.MeshStandardMaterial({
        color: 0x2f8f3a,
        roughness: 1
    });

    const leafCount = 8;

    for (let i = 0; i < leafCount; i++) {
        const angle = (i / leafCount) * Math.PI * 2;

        const leaf = new THREE.Mesh(
            new THREE.ConeGeometry(2.8, 18, 5),
            leafMaterial
        );

        leaf.position.y = trunkHeight + 1;

        leaf.rotation.z = Math.PI / 2;
        leaf.rotation.y = angle;

        leaf.translateX(8);

        leaf.scale.y = 0.65;

        leaf.castShadow = true;
        leaf.receiveShadow = true;

        palm.add(leaf);
    }

    // Немного случайного наклона всей пальмы
    palm.rotation.z = (Math.random() - 0.5) * 0.12;
    palm.rotation.x = (Math.random() - 0.5) * 0.08;

    // Ставим пальму точно на островной рельеф
    palm.position.set(
        x,
        islandTerrainHeight(x, z),
        z
    );

    scene.add(palm);

    return palm;
}


/* =========================================================
   CITIES
========================================================= */

const cities = [
    {
        name: "AURORA",
        x: -900,
        z: -400
    },

    {
        name: "NOVA CITY",
        x: 800,
        z: 1200
    },

    {
        name: "RIVER CITY",
        x: -1500,
        z: -1300
    },

    {
        name: "MEGA CITY",
        x: 1800,
        z: -800
    }
];


/* =========================================================
   CITY MARKERS
========================================================= */

function createCityMarker(city) {

    const group =
        new THREE.Group();


    const pole =
        new THREE.Mesh(
            new THREE.CylinderGeometry(
                .08,
                .08,
                30,
                6
            ),
            new THREE.MeshBasicMaterial({
                color: 0xffd34d
            })
        );

    pole.position.y = 15;

    group.add(pole);


    const ball =
        new THREE.Mesh(
            new THREE.SphereGeometry(
                1.5,
                12,
                12
            ),
            new THREE.MeshBasicMaterial({
                color: 0xffc928
            })
        );

    ball.position.y = 30;

    group.add(ball);


    group.position.set(
        city.x,
        terrainHeight(
            city.x,
            city.z
        ),
        city.z
    );

    scene.add(group);
}


cities.forEach(
    createCityMarker
);


/* =========================================================
   MEGA CITY
========================================================= */

function createMegaCity(cx, cz) {
    const city = new THREE.Group();

    // Немного уменьшаем размер Mega City
    const roadSize = 430;

    // =========================================================
    // ДОРОГИ
    // =========================================================
    const roadMaterial = new THREE.MeshStandardMaterial({
        color: 0x242424,
        roughness: 0.9,
        metalness: 0.05
    });

    for (let x = -roadSize; x <= roadSize; x += 80) {
        const road = new THREE.Mesh(
            new THREE.BoxGeometry(
                14,
                0.4,
                roadSize * 2
            ),
            roadMaterial
        );

        road.position.set(
            x,
            0,
            0
        );

        road.receiveShadow = true;
        city.add(road);
    }

    for (let z = -roadSize; z <= roadSize; z += 80) {
        const road = new THREE.Mesh(
            new THREE.BoxGeometry(
                roadSize * 2,
                0.4,
                14
            ),
            roadMaterial
        );

        road.position.set(
            0,
            0,
            z
        );

        road.receiveShadow = true;
        city.add(road);
    }

    // =========================================================
    // ЗДАНИЯ
    // =========================================================
    for (let x = -roadSize + 28; x <= roadSize - 28; x += 80) {
        for (let z = -roadSize + 28; z <= roadSize - 28; z += 80) {

            // Небольшие пустые места между зданиями
            if (Math.random() < 0.12) {
                continue;
            }

            const distance =
                Math.sqrt(x * x + z * z);

            let height;

            // Центр города выше
            if (distance < 160) {
                height =
                    180 +
                    Math.random() * 260;
            } else {
                height =
                    30 +
                    Math.random() * 130;
            }

            const width =
                25 +
                Math.random() * 25;

            const depth =
                25 +
                Math.random() * 25;

            const buildingMaterial =
                new THREE.MeshStandardMaterial({
                    color: new THREE.Color(
                        0.18 +
                        Math.random() * 0.12,
                        0.20 +
                        Math.random() * 0.12,
                        0.24 +
                        Math.random() * 0.14
                    ),
                    roughness: 0.7,
                    metalness: 0.2
                });

            const building = new THREE.Mesh(
                new THREE.BoxGeometry(
                    width,
                    height,
                    depth
                ),
                buildingMaterial
            );

            building.position.set(
                x,
                height / 2,
                z
            );

            building.castShadow = true;
            building.receiveShadow = true;

            city.add(building);

            // =================================================
            // ОКНА
            // =================================================
            if (height > 100) {
                const windowMaterial =
                    new THREE.MeshBasicMaterial({
                        color: 0xffd76a
                    });

                const windowRows =
                    Math.min(
                        8,
                        Math.floor(height / 45)
                    );

                for (let row = 0; row < windowRows; row++) {

                    const window = new THREE.Mesh(
                        new THREE.BoxGeometry(
                            width * 0.55,
                            2,
                            0.5
                        ),
                        windowMaterial
                    );

                    window.position.set(
                        x,
                        20 + row * 40,
                        z - depth / 2 - 0.3
                    );

                    city.add(window);
                }
            }
        }
    }

    // =========================================================
    // ЦЕНТРАЛЬНЫЕ НЕБОСКРЁБЫ
    // =========================================================
    const skyscraperCount = 10;

    for (let i = 0; i < skyscraperCount; i++) {

        const angle =
            (i / skyscraperCount) *
            Math.PI * 2;

        const radius =
            70 +
            Math.random() * 120;

        const x =
            Math.cos(angle) * radius;

        const z =
            Math.sin(angle) * radius;

        const height =
            300 +
            Math.random() * 400;

        const width =
            35 +
            Math.random() * 20;

        const tower = new THREE.Mesh(
            new THREE.BoxGeometry(
                width,
                height,
