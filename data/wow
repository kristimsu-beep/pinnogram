/* =========================================================
   MOUSE CAMERA
========================================================= */

let dragging = false;

let lastMouseX = 0;
let lastMouseY = 0;


renderer.domElement.addEventListener(
    "mousedown",
    e => {

        if (cockpitView)
            return;

        if (e.button !== 0)
            return;

        dragging = true;

        lastMouseX = e.clientX;
        lastMouseY = e.clientY;
    }
);


window.addEventListener(
    "mouseup",
    () => {

        dragging = false;
    }
);


window.addEventListener(
    "mousemove",
    e => {

        if (!dragging)
            return;

        if (cockpitView)
            return;


        const dx =
            e.clientX -
            lastMouseX;

        const dy =
            e.clientY -
            lastMouseY;


        lastMouseX =
            e.clientX;

        lastMouseY =
            e.clientY;


        cameraYaw -=
            dx * .006;

        cameraPitch -=
            dy * .004;


        cameraPitch =
            THREE.MathUtils.clamp(
                cameraPitch,
                THREE.MathUtils.degToRad(-10),
                THREE.MathUtils.degToRad(75)
            );
    }
);


renderer.domElement.addEventListener(
    "wheel",
    e => {

        if (cockpitView)
            return;

        cameraDistance +=
            e.deltaY * .05;


        cameraDistance =
            THREE.MathUtils.clamp(
                cameraDistance,
                18,
                180
            );
    }
);


/* =========================================================
   FLIGHT PHYSICS
========================================================= */

function updateFlight(dt) {
    // Тяга постепенно уменьшается при выключенном двигателе
    if (!flight.engine) {
        flight.throttle *= Math.pow(0.2, dt);
    }

    // Управление тягой
    if (keys["r"]) {
        flight.throttle += 0.008 * dt;
    }

    if (keys["y"]) {
        flight.throttle -= 0.012 * dt;
    }

    flight.throttle = THREE.MathUtils.clamp(
        flight.throttle,
        0,
        1
    );

    // Тангаж
    if (keys["w"]) {
        flight.pitch += 0.018 * dt;
    }

    if (keys["s"]) {
        flight.pitch -= 0.018 * dt;
    }

    // Крен
    if (keys["a"]) {
        flight.roll += 0.025 * dt;
    }

    if (keys["d"]) {
        flight.roll -= 0.025 * dt;
    }

    // Рыскание
    if (keys["q"]) {
        flight.heading += 0.018 * dt;
    }

    if (keys["e"]) {
        flight.heading -= 0.018 * dt;
    }

    // Плавное возвращение самолёта
    flight.pitch *= Math.pow(0.985, dt);
    flight.roll *= Math.pow(0.975, dt);

    // Скорость зависит от тяги
    const targetSpeed = flight.throttle * 520;

    flight.speed +=
        (targetSpeed - flight.speed) *
        0.008 *
        dt;

    if (!flight.engine) {
        flight.speed *= Math.pow(0.996, dt);
    }

    flight.speed = Math.max(0, flight.speed);

    // =========================================================
    // НАПРАВЛЕНИЕ ПОЛЁТА
    // =========================================================
    // Нос самолёта в модели направлен в сторону -Z,
    // поэтому движение тоже должно быть в сторону -Z.
    const radians = flight.heading;

    const forward = new THREE.Vector3(
        -Math.sin(radians),
        0,
        -Math.cos(radians)
    );

    // Вертикальная скорость от тангажа
    flight.verticalSpeed =
        Math.sin(flight.pitch) *
        flight.speed *
        0.018;

    if (flight.speed < 30) {
        flight.verticalSpeed *= 0.3;
    }

    // Движение вперёд
    airplane.position.x +=
        forward.x *
        flight.speed *
        dt *
        0.002;

    airplane.position.z +=
        forward.z *
        flight.speed *
        dt *
        0.002;

    // Движение вверх/вниз
    airplane.position.y +=
        flight.verticalSpeed *
        dt;

    // =========================================================
    // ЗЕМЛЯ / ОСТРОВНОЙ РЕЛЬЕФ
    // =========================================================
    const ground = islandTerrainHeight(
        airplane.position.x,
        airplane.position.z
    );

    // Самолёт не может провалиться в землю
    if (airplane.position.y < ground + 35) {
        airplane.position.y = ground + 35;

        flight.verticalSpeed = Math.max(
            0,
            flight.verticalSpeed
        );
    }

    // Высота
    flight.altitude = airplane.position.y;

    // Расход топлива
    flight.fuel -=
        flight.throttle *
        0.0007 *
        dt;

    flight.fuel = Math.max(
        0,
        flight.fuel
    );

    // =========================================================
    // ПОВОРОТ САМОЛЁТА
    // =========================================================
    airplane.rotation.order = "YXZ";

    airplane.rotation.y = flight.heading;

    airplane.rotation.x = -flight.pitch;

    airplane.rotation.z = flight.roll;
}


/* =========================================================
   DAY / NIGHT
========================================================= */

const DAY_LENGTH =
    5 * 60;


let gameSeconds =
    7 * 3600;


const SKY_DAY =
    new THREE.Color(
        0x82cdf7
    );


const SKY_DAWN =
    new THREE.Color(
        0xffb37a
    );


const SKY_SUNSET =
    new THREE.Color(
        0xf08b5c
    );


const SKY_DUSK =
    new THREE.Color(
        0x493b68
    );


const SKY_NIGHT =
    new THREE.Color(
        0x020611
    );


const skyCurrent =
    SKY_DAY.clone();


function updateDayNight(dt) {

    gameSeconds +=
        dt /
        60 *
        86400 /
        DAY_LENGTH;


    if (
        gameSeconds >= 86400
    ) {

        gameSeconds -=
            86400;
    }


    const hour =
        gameSeconds / 3600;


    let daylight =
        Math.max(
            0,
            Math.sin(
                (
                    hour - 6
                ) /
                12 *
                Math.PI
            )
        );


    const sunAngle =
        (
            hour - 6
        ) /
        24 *
        Math.PI *
        2;


    sunLight.position.set(
        Math.cos(sunAngle) * 4000,
        Math.sin(sunAngle) * 4000,
        -1200
    );


    moonLight.position.set(
        -sunLight.position.x,
        -sunLight.position.y,
        1200
    );


    sunLight.intensity =
        .15 +
        daylight * 1.85;


    moonLight.intensity =
        .05 +
        (1 - daylight) * .45;


    hemiLight.intensity =
        .25 +
        daylight * 1.35;


    stars.material.opacity =
        THREE.MathUtils.clamp(
            1 -
            daylight * 2.2,
            0,
            1
        );


    moon.material.opacity =
        THREE.MathUtils.clamp(
            (1 - daylight) * .85,
            0,
            .85
        );


    moon.position.set(
        -sunLight.position.x,
        -sunLight.position.y,
        1200
    );


    let targetSky;
    let period;


    if (
        hour < 5 ||
        hour >= 21
    ) {

        targetSky =
            SKY_NIGHT;

        period =
            "🌙 NIGHT";

    } else if (
        hour < 7
    ) {

        targetSky =
            SKY_DAWN;

        period =
            "🌅 DAWN";

    } else if (
        hour < 9
    ) {

        targetSky =
            SKY_DAY;

        period =
            "🌄 MORNING";

    } else if (
        hour < 17
    ) {

        targetSky =
            SKY_DAY;

        period =
            "☀️ DAY";

    } else if (
        hour < 19
    ) {

        targetSky =
            SKY_SUNSET;

        period =
            "🌇 SUNSET";

    } else {

        targetSky =
            SKY_DUSK;

        period =
            "🌆 DUSK";
    }


    skyCurrent.lerp(
        targetSky,
        .025
    );


    scene.background.copy(
        skyCurrent
    );


    scene.fog.color.copy(
        skyCurrent
    );


    const hours =
        Math.floor(hour);

    const minutes =
        Math.floor(
            (hour - hours) * 60
        );


    timeClock.textContent =
        String(hours).padStart(
            2,
            "0"
        )
        +
        ":"
        +
        String(minutes).padStart(
            2,
            "0"
        );


    timePeriod.textContent =
        period;
}


/* =========================================================
   BIOME
========================================================= */

function getBiome(x, z) {

    if (z > 1900)
        return "ANTARCTICA";

    if (
        x > 600 &&
        z > 400
    )
        return "DESERT";

    if (
        x < -500 &&
        z > 300
    )
        return "JUNGLE";

    const h =
        terrainHeight(x, z);


    if (h > 260)
        return "MOUNTAINS";

    if (h > 140)
        return "HILLS";

    return "PLAINS";
}


/* =========================================================
   NAVIGATION MAP
========================================================= */

const navCanvas =
    document.getElementById(
        "navMap"
    );

const navCtx =
    navCanvas.getContext(
        "2d"
    );


function drawNavigation() {

    const w =
        navCanvas.width;

    const h =
        navCanvas.height;


    navCtx.clearRect(
        0,
        0,
        w,
        h
    );


    const scale =
        .045;


    const centerX =
        airplane.position.x;

    const centerZ =
        airplane.position.z;


    /* RELIEF */

    /*
       LIGHT OPTIMIZATION:
       Было 5 пикселей.
       Стало 8.

       Карта всё равно остаётся 250x250,
       но terrainHeight() вызывается намного реже.
    */

    const navStep = 8;


    for (
        let px = 0;
        px < w;
        px += navStep
    ) {

        for (
            let pz = 0;
            pz < h;
            pz += navStep
        ) {

            const worldX =
                centerX +
                (px - w / 2) /
                scale;


            const worldZ =
                centerZ +
                (pz - h / 2) /
                scale;


            let color;


            if (worldZ > 1900) {

                color =
                    "#eaf4ff";

            } else {

                const height =
                    terrainHeight(
                        worldX,
                        worldZ
                    );


                if (
                    height < -5
                ) {

                    color =
                        "#165a82";

                } else if (
                    worldX > 600 &&
                    worldZ > 400
                ) {

                    color =
                        "#c49a52";

                } else if (
                    worldX < -500 &&
                    worldZ > 300
                ) {

                    color =
                        "#24703a";

                } else if (
                    height > 260
                ) {

                    color =
                        "#85847c";

                } else if (
                    height > 140
                ) {

                    color =
                        "#777844";

                } else {

                    color =
                        "#4d9347";
                }
            }


            navCtx.fillStyle =
                color;


            navCtx.fillRect(
                px,
                pz,
                navStep,
                navStep
            );
        }
    }


    /* GRID */

    navCtx.strokeStyle =
        "rgba(255,255,255,.15)";

    navCtx.lineWidth = 1;


    for (
        let x = 0;
        x < w;
        x += 50
    ) {

        navCtx.beginPath();

        navCtx.moveTo(
            x,
            0
        );

        navCtx.lineTo(
            x,
            h
        );

        navCtx.stroke();
    }


    for (
        let y = 0;
        y < h;
        y += 50
    ) {

        navCtx.beginPath();

        navCtx.moveTo(
            0,
            y
        );

        navCtx.lineTo(
            w,
            y
        );

        navCtx.stroke();
    }


    /* AIRPORTS */

    airports.forEach(
        airport => {

            const x =
                w / 2 +
                (
                    airport.x -
                    centerX
                ) *
                scale;


            const y =
                h / 2 +
                (
                    airport.z -
                    centerZ
                ) *
                scale;


            if (
                x < 0 ||
                x > w ||
                y < 0 ||
                y > h
            )
                return;


            navCtx.fillStyle =
                "#ffffff";


            navCtx.fillRect(
                x - 3,
                y - 3,
                6,
                6
            );


            navCtx.fillStyle =
                "rgba(255,255,255,.85)";


            navCtx.font =
                "9px Arial";


            navCtx.fillText(
                airport.name,
                x + 6,
                y - 5
            );
        }
    );


    /* MEGA CITY */

    const mx =
        w / 2 +
        (
            1800 -
            centerX
        ) *
        scale;


    const my =
        h / 2 +
        (
            -800 -
            centerZ
        ) *
        scale;


    if (
        mx >= 0 &&
        mx <= w &&
        my >= 0 &&
        my <= h
    ) {

        navCtx.strokeStyle =
            "#ffd23c";

        navCtx.lineWidth = 2;

        navCtx.beginPath();

        navCtx.arc(
            mx,
            my,
            9,
            0,
            Math.PI * 2
        );

        navCtx.stroke();


        navCtx.fillStyle =
            "#fff0a0";

        navCtx.font =
            "bold 9px Arial";

        navCtx.fillText(
            "MEGA CITY",
            mx + 11,
            my - 8
        );
    }


    /* PLANE */

    const px =
        w / 2;

    const py =
        h / 2;


    navCtx.save();

    navCtx.translate(
        px,
        py
    );


    navCtx.rotate(
        -flight.heading
    );


    navCtx.fillStyle =
        "#ff3e3e";


    navCtx.beginPath();

    navCtx.moveTo(
        0,
        -10
    );

    navCtx.lineTo(
        6,
        8
    );

    navCtx.lineTo(
        0,
        5
    );

    navCtx.lineTo(
        -6,
        8
    );

    navCtx.closePath();

    navCtx.fill();

    navCtx.restore();


    /* COMPASS */

    navCtx.fillStyle =
        "white";

    navCtx.font =
        "bold 12px Arial";

    navCtx.fillText(
        "N",
        w / 2 - 4,
        14
    );
}


/* =========================================================
   HUD
========================================================= */

const altitudeEl =
    document.getElementById(
        "altitude"
    );

const speedEl =
    document.getElementById(
        "speed"
    );

const headingEl =
    document.getElementById(
        "heading"
    );

const verticalSpeedEl =
    document.getElementById(
        "verticalSpeed"
    );

const throttleEl =
    document.getElementById(
        "throttle"
    );

const fuelEl =
    document.getElementById(
        "fuel"
    );

const engineEl =
    document.getElementById(
        "engine"
    );

const biomeEl =
    document.getElementById(
        "biome"
    );

const timeClock =
    document.getElementById(
        "timeClock"
    );

const timePeriod =
    document.getElementById(
        "timePeriod"
    );

const messageEl =
    document.getElementById(
        "message"
    );

const cameraLabel =
    document.getElementById(
        "cameraLabel"
    );


function updateHUD() {

    altitudeEl.textContent =
        Math.round(
            flight.altitude
        ) + " m";


    speedEl.textContent =
        Math.round(
            flight.speed
        ) + " km/h";


    let degrees =
        THREE.MathUtils.radToDeg(
            flight.heading
        );


    degrees =
        (
            degrees % 360 +
            360
        ) % 360;


    headingEl.textContent =
        String(
            Math.round(degrees)
        ).padStart(
            3,
            "0"
        ) + "°";


    verticalSpeedEl.textContent =
        flight.verticalSpeed
            .toFixed(1)
        + " m/s";


    throttleEl.textContent =
        Math.round(
            flight.throttle * 100
        ) + "%";


    fuelEl.textContent =
        Math.round(
            flight.fuel
        ) + "%";


    engineEl.textContent =
        flight.engine
            ? "ON"
            : "OFF";


    biomeEl.textContent =
        getBiome(
            airplane.position.x,
            airplane.position.z
        );
}


/* =========================================================
   MESSAGE
========================================================= */

let messageTimer;


function showMessage(text) {

    messageEl.textContent =
        text;

    messageEl.style.opacity =
        "1";


    clearTimeout(
        messageTimer
    );


    messageTimer =
        setTimeout(
            () => {

                messageEl.style.opacity =
                    "0";

            },
            1800
        );
}


/* =========================================================
   START
========================================================= */

let started = false;


document
    .getElementById("startButton")
    .addEventListener(
        "click",
        () => {

            started = true;

            document
                .getElementById("menu")
                .style.display =
                    "none";


            cameraInitialized =
                false;


            updateCamera();


            showMessage(
                "✈️ WELCOME TO SKYWORLD"
            );
        }
    );


/* =========================================================
   RESIZE
========================================================= */

window.addEventListener(
    "resize",
    () => {

        camera.aspect =
            innerWidth /
            innerHeight;


        camera.updateProjectionMatrix();


        renderer.setSize(
            innerWidth,
            innerHeight
        );
    }
);


/* =========================================================
   MAIN LOOP
========================================================= */

let lastTime =
    performance.now();


/*
   NAVIGATION TIMER

   drawNavigation() больше не запускается
   на каждом кадре.

   Это было одним из самых тяжёлых мест:
   раньше за каждый кадр выполнялись
   тысячи вызовов terrainHeight().
*/
let navigationTimer = 0;


/*
   HUD тоже обновляем немного реже.
   На физику это НЕ влияет.
*/
let hudTimer = 0;


function animate(now) {

    requestAnimationFrame(
        animate
    );


    const realDeltaMs =
        now - lastTime;


    const dt =
        Math.min(
            realDeltaMs / 16.67,
            3
        );


    lastTime =
        now;


    if (started) {

        /*
           ФИЗИКА ОСТАЁТСЯ КАЖДЫЙ КАДР.
        */
        updateFlight(dt);


        updateDayNight(dt);


        updateCamera();


        /*
           HUD примерно 10 раз в секунду.
           Это не влияет на игру.
        */
        hudTimer += realDeltaMs;

        if (hudTimer >= 100) {

            updateHUD();

            hudTimer = 0;
        }


        /*
           NAV MAP примерно 5-6 раз в секунду.
        */
        navigationTimer += realDeltaMs;

        if (navigationTimer >= 180) {

            drawNavigation();

            navigationTimer = 0;
        }
    }


    renderer.render(
        scene,
        camera
    );
}


animate(
    performance.now()
);

</script>

