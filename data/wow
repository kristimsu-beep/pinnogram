    // =========================================================
    // УЛИЧНОЕ ОСВЕЩЕНИЕ
    // =========================================================
    const streetLightPositions = [
        [-380, -380],
        [0, -380],
        [380, -380],

        [-380, 0],
        [380, 0],

        [-380, 380],
        [0, 380],
        [380, 380],

        [0, -250],
        [0, 250],

        [-250, 0],
        [250, 0],

        [-180, -180],
        [180, -180],
        [-180, 180],
